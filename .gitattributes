# Normalise line endings on commit, check out native
* text=auto

*.py    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf

*.xlsx  binary
*.png   binary
*.jpg   binary
*.pdf   binary

# The spreadsheet is historical input, not maintained source
docs/input/*.xlsx linguist-vendored
