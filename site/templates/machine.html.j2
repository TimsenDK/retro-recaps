{% extends "base.html.j2" %}
{% block title %}{{ machine.name }} · {{ site_name }}{% endblock %}
{% block description %}Capacitor replacement lists for the {{ machine.name }}, board by board.{% endblock %}
{% block body_class %}fam-{{ machine.family }}{% endblock %}
{% block content %}

<p class="crumbs"><a href="{{ base }}index.html">Machines</a></p>

<h1 class="pagetitle">{{ machine.name }}</h1>

<div class="hero">
    <div>
        <p class="lede">
            <a class="famchip" href="{{ base }}index.html#{{ machine.family }}">
                {% if machine.family_mark_url %}
                <img class="mark" src="{{ base }}{{ machine.family_mark_url }}" alt="" aria-hidden="true">
                {% endif %}
                {{ machine.family_name }}</a>
            {% if machine.aliases %}Also known as
            {{ machine.aliases | join(', ') }}.{% endif %}
            {{ machine.coverage.summary }}.
        </p>
        <p>
            <span class="badge tone-{{ machine.coverage.tone }}">{{ machine.coverage.group_label }}</span>
            {{ machine.coverage.group_headline }}
        </p>
    </div>
    {% with card = false, link = none %}{% include "_photo.html.j2" %}{% endwith %}
</div>

{% with hazards = machine.hazards %}{% include "_hazards.html.j2" %}{% endwith %}

{% if machine.notes %}
<h2>Notes on this machine</h2>
{% with notes = machine.linked_notes %}{% include "_notes.html.j2" %}{% endwith %}
{% endif %}

<h2>Boards, in the order to recap them</h2>
{% if machine.boards %}
<ol class="cards">
    {% for board in machine.boards %}
    <li class="card">
        <a href="{{ base }}{{ board.url }}">{{ board.title }}</a>
        <span class="meta">
            {% if board.revision_label and board.title == board.kind_label %}
            {{ board.revision_label }} ·
            {% endif %}
            {% if board.is_empty %}
            no list established
            {% else %}
            {{ board.capacitor_count }} capacitor{{ '' if board.capacitor_count == 1 else 's' }}
            {% endif %}
        </span>
        <span class="badge tone-{{ board.verification.tone }}">{{ board.verification.label }}</span>
    </li>
    {% endfor %}
</ol>
{% else %}
<p>No board files exist for this machine yet.</p>
{% endif %}

{# Context, not capacitor data. It sits at the foot of the page because a
   reader arrives here holding the board and wanting the list; what the machine
   was is worth having and is never the reason they came. #}
{% if machine.about %}
<aside class="about">
    <h2>About the {{ machine.name }}</h2>
    <p class="released"><span>Introduced</span> {{ machine.released_year }}</p>
    <p>{{ machine.about }}</p>
    {% if machine.wikipedia %}
    <p class="onward">Read more: <a href="{{ machine.wikipedia }}"
       rel="noopener">{{ machine.wikipedia_title }}</a> on Wikipedia.</p>
    {% endif %}
</aside>
{% endif %}

{% endblock %}
