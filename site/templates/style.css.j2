/* ---------- fonts ----------
   Self-hosted, OFL, and never base64: this sheet is inlined into every one
   of the site's pages, so an embedded font would be paid for ninety times
   over. The files sit in `assets/fonts/` and are fetched once and cached.

   `{{ '{{ base }}' }}` is the page's path back to the site root, so these URLs
   resolve from `index.html` and from `<machine>/<board>.html` alike.

   Every face is `font-display: swap`: the page is readable in the fallback
   before the font lands, and stays readable if it never does. */

/* Chakra Petch: a squared techno grotesque, the lettering of 1980s equipment
   panels rather than of their screens. Chosen over the bitmap faces on
   measurement — Silkscreen set "Macintosh Classic II" at 15.25 em in the bold
   the masthead uses, against a 360 px phone budget of 11.76 em, and had no
   ohm sign. This sets the same string in 9.42 em against IBM Plex Sans's
   9.06, so the print substitution barely moves the line. */

@font-face {
    font-family: "Chakra Petch";
    src: url("{{ base }}assets/fonts/chakra-petch-400.woff2") format("woff2");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
}

@font-face {
    font-family: "Chakra Petch";
    src: url("{{ base }}assets/fonts/chakra-petch-700.woff2") format("woff2");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
}

/* One variable file covers 400 to 700. The `wdth` axis is pinned upstream,
   so this is weight only. */
@font-face {
    font-family: "IBM Plex Sans";
    src: url("{{ base }}assets/fonts/ibm-plex-sans-var.woff2") format("woff2");
    font-weight: 400 700;
    font-style: normal;
    font-display: swap;
}

@font-face {
    font-family: "IBM Plex Mono";
    src: url("{{ base }}assets/fonts/ibm-plex-mono-400.woff2") format("woff2");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
}

@font-face {
    font-family: "IBM Plex Mono";
    src: url("{{ base }}assets/fonts/ibm-plex-mono-700.woff2") format("woff2");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
}

:root {
    color-scheme: light dark;
    --page: #f4f0e8;
    --panel: #fffdf8;
    --panel-alt: #ebe5d9;
    --ink: #22201c;
    --ink-soft: #5c574d;
    --rule: #d5cdbc;
    --rule-strong: #b8ad97;
    --accent: #8c3b1e;
    --accent-ink: #ffffff;
    --ok-bg: #e2eddf;
    --ok-ink: #23532f;
    --ok-rule: #4a7d55;
    --caution-bg: #fbeccd;
    --caution-ink: #6d4a04;
    --caution-rule: #b8820f;
    --warn-bg: #f7dcd6;
    --warn-ink: #7a2113;
    --warn-rule: #b13c22;
    /* The tables are read with a board in one hand, so the mono face leads
       with the one that has a slashed zero and unmistakable 1/l/I. */
    --mono: "IBM Plex Mono", ui-monospace, SFMono-Regular, "SF Mono", Menlo,
        Consolas, "Liberation Mono", monospace;
    --sans: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", Roboto,
        "Helvetica Neue", Arial, sans-serif;
    /* Headings only. A display face is a costume; it must never carry a
       sentence, a table cell, or a hazard warning. The fallback is the
       body sans, so a heading that loses the font is still a heading. */
    --display: "Chakra Petch", "IBM Plex Sans", system-ui, -apple-system,
        "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    /* The bezel a photograph sits in. Dark in both themes — a CRT surround
       was, and a light frame around a light photograph frames nothing. */
    --bezel: #3a352d;
    --bezel-edge: #26221c;
    --bezel-ink: #efe9db;
    /* Fallbacks for the family accents below, so a family the palette does
       not name still renders in the site accent rather than in nothing. */
    --family-ink: var(--accent);
    --family-chip: var(--panel-alt);
}

/* ---------- family accents ----------
   Four families, four accents, used on the index, the machine pages and the
   board pages so a page announces which family it belongs to before its
   heading is read.

   These evoke the era; they are not the manufacturers' brand colours and
   claim no affiliation. They are also kept clear of the three tones the site
   uses to mean something — green for verified, amber for caution, red for a
   hazard — so nothing can read a family accent as a status.

   `--family-ink` carries text and edges, `--family-chip` is a tint it sits
   on. Measured against `--page`, `--panel` and `--panel-alt`, the worst pair
   in either theme is 5.09:1, comfortably past AA for body text and past 3:1
   for edges. */

.fam-amiga {
    --family-ink: #8a2f8f;
    --family-chip: #f3e7f4;
}

.fam-commodore-8bit {
    --family-ink: #2f47b8;
    --family-chip: #e4e8fb;
}

.fam-commodore-drive {
    --family-ink: #0e6a6a;
    --family-chip: #dcefee;
}

.fam-macintosh {
    --family-ink: #4a5563;
    --family-chip: #e7e9ec;
}

@media (prefers-color-scheme: dark) {
    :root {
        --page: #1b1a17;
        --panel: #232220;
        --panel-alt: #2c2a26;
        --ink: #ece7dc;
        --ink-soft: #a49d8f;
        --rule: #3d3a34;
        --rule-strong: #565147;
        --accent: #e08b62;
        --accent-ink: #1b1a17;
        --ok-bg: #1e2f22;
        --ok-ink: #9ed3ac;
        --ok-rule: #4f8a5e;
        --caution-bg: #33280f;
        --caution-ink: #f0c766;
        --caution-rule: #a9820f;
        --warn-bg: #3a1a13;
        --warn-ink: #f4a48f;
        --warn-rule: #c25030;
        --bezel: #100f0d;
        --bezel-edge: #060605;
        --bezel-ink: #cfc8b8;
    }

    .fam-amiga {
        --family-ink: #dfa0e4;
        --family-chip: #33203a;
    }

    .fam-commodore-8bit {
        --family-ink: #9db4f5;
        --family-chip: #1f2540;
    }

    .fam-commodore-drive {
        --family-ink: #79cfc9;
        --family-chip: #152f30;
    }

    .fam-macintosh {
        --family-ink: #b9c4d2;
        --family-chip: #262b32;
    }
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: var(--page);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 17px;
    line-height: 1.55;
    -webkit-text-size-adjust: 100%;
}

.wrap {
    max-width: 62rem;
    margin: 0 auto;
    padding: 0 1.25rem 5rem;
}

a {
    color: var(--accent);
}

a:hover {
    text-decoration-thickness: 2px;
}

code,
.mono,
.designators,
.value {
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
}

/* ---------- masthead ---------- */

.masthead {
    border-bottom: 3px solid var(--rule-strong);
    background: var(--panel);
}

/* A strip of board — DIP, two capacitor positions, a few traces — repeated
   along the foot of the masthead. Purely decorative, which is why it is a
   background rather than an element: it is not in the accessibility tree and
   there is nothing for a screen reader to skip. */
.masthead .motif {
    height: 15px;
    background: url("{{ base }}assets/img/masthead-board.svg") repeat-x left
        center;
    background-size: auto 15px;
    opacity: 0.4;
}

.masthead .wrap {
    padding-top: 1rem;
    padding-bottom: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    align-items: baseline;
    justify-content: space-between;
}

.masthead a.brand {
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--ink);
}

.masthead a.brand span {
    color: var(--accent);
}

.masthead nav {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    font-size: 0.95rem;
}

/* ---------- headings ---------- */

h1,
h2,
h3,
.masthead a.brand {
    font-family: var(--display);
    /* A pixel face is wide. "Macintosh Classic II" is 13 em of it, which
       is wider than a phone at the smallest heading size, and a heading
       must not be what makes the page scroll sideways. */
    overflow-wrap: break-word;
}

/* The panels carry safety copy. They keep the body face: a warning is not
   the place to spend legibility on decoration. */
.verdict h2,
.hazard h2,
.battery h2,
.open-question h2 {
    font-family: var(--sans);
}

h1 {
    font-size: clamp(1.7rem, 1.2rem + 2vw, 2.4rem);
    line-height: 1.15;
    margin: 2rem 0 0.25rem;
}

h2 {
    font-size: 1.3rem;
    margin: 2.5rem 0 0.75rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--rule);
}

h3 {
    font-size: 1.05rem;
    margin: 1.5rem 0 0.4rem;
}

.lede {
    color: var(--ink-soft);
    font-size: 1.05rem;
    margin: 0 0 1.5rem;
}

.crumbs {
    font-size: 0.9rem;
    color: var(--ink-soft);
    margin: 1.5rem 0 0;
}

/* ---------- badge ---------- */

.badge {
    display: inline-block;
    padding: 0.1rem 0.5rem;
    border-radius: 0.2rem;
    border: 1px solid;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    white-space: nowrap;
}

.tone-verified {
    background: var(--ok-bg);
    color: var(--ok-ink);
    border-color: var(--ok-rule);
}

.tone-caution {
    background: var(--caution-bg);
    color: var(--caution-ink);
    border-color: var(--caution-rule);
}

.tone-warning,
.tone-unknown {
    background: var(--warn-bg);
    color: var(--warn-ink);
    border-color: var(--warn-rule);
}

/* The verification panel at the top of a board page. */
.verdict {
    margin: 1.5rem 0;
    padding: 1rem 1.1rem;
    border: 1px solid;
    border-left-width: 8px;
    border-radius: 0.3rem;
}

.verdict h2 {
    margin: 0 0 0.35rem;
    border: 0;
    padding: 0;
    font-size: 1.15rem;
}

.verdict p {
    margin: 0;
}

.verdict.tone-caution h2::before,
.verdict.tone-warning h2::before,
.verdict.tone-unknown h2::before {
    content: "\26A0\FE0E  ";
}

.verdict.tone-caution,
.verdict.tone-warning,
.verdict.tone-unknown {
    font-weight: 500;
}

/* ---------- hazards ---------- */

.hazard {
    margin: 1.25rem 0;
    padding: 1rem 1.1rem;
    border: 2px solid var(--warn-rule);
    border-radius: 0.3rem;
    background: var(--warn-bg);
    color: var(--warn-ink);
}

.hazard h2 {
    margin: 0 0 0.35rem;
    border: 0;
    padding: 0;
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

.hazard h2::before {
    content: "\26A1\FE0E  ";
}

.hazard p {
    margin: 0 0 0.5rem;
}

.hazard a {
    color: inherit;
    font-weight: 700;
}

/* ---------- battery ---------- */

.battery {
    margin: 1.25rem 0;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--caution-rule);
    border-left-width: 8px;
    border-radius: 0.3rem;
    background: var(--caution-bg);
    color: var(--caution-ink);
}

.battery h2 {
    margin: 0 0 0.35rem;
    border: 0;
    padding: 0;
    font-size: 1.1rem;
}

.battery ul.notes {
    margin: 0;
}

.battery .note {
    display: block;
    margin-top: 0.5rem;
}

/* ---------- open question ---------- */

.open-question {
    margin: 1.5rem 0;
    padding: 1.25rem 1.35rem;
    border: 2px dashed var(--rule-strong);
    border-radius: 0.3rem;
    background: var(--panel-alt);
}

.open-question h2 {
    margin: 0 0 0.5rem;
    border: 0;
    padding: 0;
}

.open-question p:last-child {
    margin-bottom: 0;
}

/* ---------- tables ---------- */

.scroller {
    overflow-x: auto;
    border: 1px solid var(--rule);
    border-radius: 0.3rem;
    background: var(--panel);
}

table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.95rem;
}

caption {
    text-align: left;
    color: var(--ink-soft);
    font-size: 0.9rem;
    padding: 0.5rem 0.75rem;
}

th,
td {
    text-align: left;
    padding: 0.55rem 0.75rem;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
}

thead th {
    background: var(--panel-alt);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-soft);
    white-space: nowrap;
}

tbody tr:last-child td {
    border-bottom: 0;
}

td.designators {
    font-weight: 700;
    white-space: nowrap;
}

td.value {
    white-space: nowrap;
}

.was {
    display: block;
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--ink-soft);
}

.tick {
    width: 1.6rem;
    text-align: center;
}

.tick span {
    display: inline-block;
    width: 1rem;
    height: 1rem;
    border: 1px solid var(--rule-strong);
    border-radius: 0.15rem;
}

td .note {
    display: block;
    font-size: 0.85rem;
    color: var(--ink-soft);
    max-width: 26rem;
}

/* ---------- cards ---------- */

.cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
}

.card {
    border: 1px solid var(--rule);
    border-radius: 0.3rem;
    background: var(--panel);
    padding: 0.85rem 1rem;
}

.card a {
    font-weight: 600;
    text-decoration: none;
}

.card a:hover {
    text-decoration: underline;
}

.card .meta {
    display: block;
    font-size: 0.85rem;
    color: var(--ink-soft);
    margin-top: 0.2rem;
}

.card .badge {
    margin-top: 0.5rem;
}

.notes {
    padding-left: 1.1rem;
}

.notes li {
    margin-bottom: 0.4rem;
}

.sources li {
    margin-bottom: 0.75rem;
}

.sources .note {
    display: block;
    font-size: 0.9rem;
    color: var(--ink-soft);
}

.sources a {
    word-break: break-word;
}

.datalinks {
    font-size: 0.9rem;
    color: var(--ink-soft);
}

.printonly {
    display: none;
}

footer.site {
    border-top: 1px solid var(--rule);
    margin-top: 4rem;
    padding-top: 1rem;
    font-size: 0.85rem;
    color: var(--ink-soft);
}

/* ---------- family headings and family-tinted cards ---------- */

h2.family {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--family-ink);
    border-bottom-width: 2px;
    border-bottom-color: var(--family-ink);
}

h2.family .mark {
    width: 1.7rem;
    height: 1.7rem;
    flex: none;
}

/* The family accent as a chunky left edge — the one place on the index where
   a card says which family it belongs to without a word. The name is in the
   heading above it, so nothing depends on the colour. */
.card {
    border-left: 5px solid var(--family-ink);
}

.card .badge {
    display: inline-block;
}

@media (hover: hover) {
    .card {
        transition: transform 90ms ease-out, box-shadow 90ms ease-out;
    }

    .card:hover {
        transform: translateY(-2px);
        box-shadow: 0 3px 0 var(--rule);
    }
}

/* A machine or board page carries its family accent on the title bar and on
   one chip beside it. Both are redundant: the family is written out in the
   chip and in the lede. */
.pagetitle {
    border-left: 7px solid var(--family-ink);
    padding-left: 0.7rem;
}

.famchip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--family-ink);
    border-radius: 0.2rem;
    background: var(--family-chip);
    color: var(--family-ink);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: none;
}

.famchip .mark {
    width: 1.1rem;
    height: 1.1rem;
}

/* ---------- photographs in a screen bezel ----------
   A machine photograph sits in a moulded surround with a scanline sheen over
   it: the period is the point, and a bezel is what these machines were seen
   through. The sheen is a static gradient at low opacity over a photograph,
   never over text. */

.shot {
    margin: 0 0 1rem;
}

.shot .bezel {
    position: relative;
    background: var(--bezel);
    border: 1px solid var(--bezel-edge);
    border-radius: 0.55rem;
    padding: 0.5rem;
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.06);
}

.shot img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.25rem;
}

.shot .bezel::after {
    content: "";
    position: absolute;
    inset: 0.5rem;
    border-radius: 0.25rem;
    pointer-events: none;
    background: repeating-linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0.16) 0 1px,
        rgba(0, 0, 0, 0) 1px 3px
    );
    opacity: 0.5;
}

.shot .credit {
    display: block;
    margin-top: 0.4rem;
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--ink-soft);
}

/* The machine with no freely licensed photograph gets the same box rather
   than a hole in the layout, and says why it is empty. */
.shot .missing {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 8rem;
    padding: 1.25rem;
    text-align: center;
    color: var(--bezel-ink);
    font-size: 0.85rem;
}

.shot .missing .mark {
    width: 2.5rem;
    height: 2.5rem;
    opacity: 0.7;
}

.hero {
    display: grid;
    gap: 1.25rem;
    align-items: start;
    margin: 1.5rem 0;
}

@media (min-width: 45rem) {
    .hero {
        grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }

    .hero .shot {
        margin: 0;
    }
}

.card .shot {
    margin-bottom: 0.6rem;
}

.card .shot .bezel {
    padding: 0.3rem;
    border-radius: 0.4rem;
}

.card .shot .bezel::after {
    inset: 0.3rem;
}

/* ---------- capacitor type symbols ----------
   The drawing supplements the words in the cell; it never replaces them.
   Radial, axial and snap-in are three phrases that look alike and three
   parts that do not. */

td.type {
    min-width: 9rem;
}

.captype {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
}

.captype img {
    width: 26px;
    height: 26px;
    flex: none;
    margin-top: -0.1rem;
}

/* The same symbols at reading size, in the key on the reference page. */
.typekey {
    display: block;
    width: 40px;
    height: 40px;
}

/* ---------- polarity diagram ---------- */

.polarity {
    margin: 1.5rem 0;
    padding: 1rem 1.1rem 0.75rem;
    border: 2px solid var(--rule-strong);
    border-radius: 0.3rem;
    background: var(--panel);
}

.polarity h2 {
    margin: 0 0 0.5rem;
    border: 0;
    padding: 0;
    font-size: 1.05rem;
}

/* The diagram carries its own captions and they stop being readable below
   about 30rem. Rather than shrink it past that or drop it on a phone, it
   keeps its width and scrolls inside its own box — the page never scrolls
   sideways, and the drawing is never illegible. */
.polarity .frame {
    overflow-x: auto;
}

.polarity svg {
    display: block;
    width: 100%;
    min-width: 30rem;
    max-width: 34rem;
    height: auto;
    margin: 0 auto;
}

.polarity p {
    margin: 0.5rem 0 0.35rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
}

/* ---------- board map ---------- */

/* Targeted by shape, not by class name: the map is the only figure on the
   site that wraps a bare `<svg>` and carries a caption, so `figure > svg`
   and `figure > figcaption` reach it without help from a selector, and a
   board with no map leaves no trace of these rules' own name in the page it
   renders — nothing here is styled by a class the page text would echo. */
figure {
    margin: 1.5rem 0;
}

figure > svg {
    width: 100%;
    height: auto;
}

figure > figcaption {
    font-size: 0.85rem;
    color: var(--ink-soft);
    margin-top: 0.2rem;
}

/* A ring is a hollow marker so the designator inside it stays legible; the
   panel colour behind it stops a stray table rule or grid line from showing
   through the circle where currentColor is a light ink. */
.pos circle {
    fill: var(--panel);
    stroke: currentColor;
    stroke-width: 2;
}

/* Dashed rather than solid: the caption is the disclosure a reader can act
   on, but the ring still has to look different from a measured one for
   anybody scanning the drawing rather than reading the words beside it. */
.pos.approx circle {
    stroke-dasharray: 4 3;
}

.pos text {
    font-size: 18px;
    font-family: var(--mono);
}

.anchor {
    color: var(--ink-soft);
}

@media (prefers-reduced-motion: reduce) {
    .card {
        transition: none;
    }

    .card:hover {
        transform: none;
    }
}

/* ---------- search ---------- */

#search {
    width: 100%;
    padding: 0.6rem 0.75rem;
    font: inherit;
    color: inherit;
    background: var(--panel);
    border: 1px solid var(--rule-strong);
    border-radius: 0.3rem;
}

#search-results li {
    margin-bottom: 0.4rem;
}

.js-only {
    display: none;
}

/* ---------- print ---------- */

@media print {
    :root {
        --page: #fff;
        --panel: #fff;
        --panel-alt: #fff;
        --ink: #000;
        --ink-soft: #333;
        --rule: #999;
        --rule-strong: #000;
        --accent: #000;
        --ok-bg: #fff;
        --ok-ink: #000;
        --ok-rule: #000;
        --caution-bg: #fff;
        --caution-ink: #000;
        --caution-rule: #000;
        --warn-bg: #fff;
        --warn-ink: #000;
        --warn-rule: #000;
        /* The display face stays on paper. It was dropped here while the
           heading font was a bitmap, which at 10 pt on a 600 dpi printer
           is a row of grey smudges; Chakra Petch is an ordinary outline
           face and prints cleanly, so the printed sheet now carries the
           same headings as the screen and is recognisably the same
           document. The mono face stays too: it is a text face with
           tabular figures, and the tables are the point of the page. */
        /* The family accents are decoration, and a colour laser turns them
           into three greys that mean nothing. On paper everything is black
           ink on white and the family is a word, not a hue. */
        --family-ink: #000;
        --family-chip: #fff;
        --bezel: #fff;
        --bezel-edge: #000;
        --bezel-ink: #000;
    }


    body {
        font-size: 10.5pt;
        background: #fff;
        color: #000;
    }

    .masthead,
    footer.site,
    .crumbs,
    .no-print,
    #search,
    #search-results,
    .js-only {
        display: none !important;
    }

    .printonly {
        display: block;
    }

    .wrap {
        max-width: none;
        padding: 0;
    }

    a {
        color: #000;
        text-decoration: none;
    }

    .scroller {
        overflow: visible;
        border: 1px solid #000;
    }

    table {
        font-size: 9.5pt;
    }

    thead {
        display: table-header-group;
    }

    tr,
    .verdict,
    .hazard,
    .battery,
    .open-question {
        page-break-inside: avoid;
    }

    .verdict,
    .hazard,
    .battery {
        border: 2px solid #000;
    }

    /* A CRT analog board that carries mains prints two hazard panels, above
       a verdict panel and sometimes a battery panel. Uncompressed, that is
       most of a sheet before the capacitor table starts. These panels stay
       bordered and unbroken; they just stop eating the first page. */
    .verdict,
    .hazard,
    .battery {
        margin: 0.5rem 0;
        padding: 0.45rem 0.6rem;
        font-size: 9.5pt;
    }

    .verdict h2,
    .hazard h2,
    .battery h2 {
        font-size: 10pt;
    }

    .hazard p,
    .battery p {
        margin: 0 0 0.25rem;
    }

    .hazard p:last-child,
    .battery p:last-child,
    .battery ul.notes {
        margin-bottom: 0;
    }

    .verdict h2::before,
    .hazard h2::before {
        content: "! ";
    }

    h1 {
        margin-top: 0;
    }

    .print-footer {
        margin-top: 1.5rem;
        padding-top: 0.5rem;
        border-top: 1px solid #000;
        font-size: 9pt;
    }

    .print-footer .url {
        font-family: var(--mono);
        word-break: break-all;
    }

    /* The photographs, the family marks, the board motif and the type
       symbols all come off the sheet. They are referenced SVGs and JPEGs
       that cannot know the page is being printed — a symbol drawn in a dark
       theme's ink is invisible on paper — and none of them carries anything
       the words beside it do not already say. What is left is the table, the
       designators and the panels. */
    .shot,
    .masthead .motif,
    h2.family .mark,
    .famchip .mark,
    .captype img,
    .typekey {
        display: none !important;
    }

    .pagetitle {
        border-left: 0;
        padding-left: 0;
    }

    .famchip {
        border: 1px solid #000;
        background: #fff;
        color: #000;
    }

    /* The polarity diagram is the exception, and the reason it is inlined
       rather than referenced: as markup it paints in `currentColor`, so it
       goes to paper as black line art with the rest of the page. Fitting a
       part backwards is the mistake this sheet exists to prevent. */
    .polarity {
        border: 1px solid #000;
        background: #fff;
        page-break-inside: avoid;
    }

    .polarity .frame {
        overflow: visible;
    }

    .polarity svg {
        display: block;
        min-width: 0;
        max-width: 12cm;
    }

    /* The one picture that stays on the sheet. The table says what to buy
       and the map says where it goes; separating them at the bench is the
       whole problem this feature exists to solve. Reached by shape, the same
       way the screen rules above reach it: a class named `.boardmap` would
       print that word into the stylesheet inlined on every page, including
       ones with no map. */
    figure {
        break-inside: avoid;
        max-width: 12cm;
    }

    figure > svg {
        color: #000;
    }

    .pos circle {
        fill: #fff;
    }
}
