{# `batteries` is the machine's battery list, rendered on a board page and
   nowhere else, and only when that board declares `battery: true`, i.e. the
   cell really is on this PCB. The board page is the sheet that gets printed
   and carried to the bench, and a warning it cannot confirm applies is worse
   than none: the A500's cell is on rev 8A alone, so the same panel on the
   machine page told a rev 3 owner to deal with a battery their board has
   never had. #}
{% if batteries %}
<section class="battery" role="note">
    <h2>Battery — deal with this first</h2>
    <ul class="notes">
        {% for battery in batteries %}
        <li>
            <strong>{{ battery.kind | upper }} — {{ battery.action }}.</strong>
            {% if battery.note %}{{ battery.note }}{% endif %}
            {% if battery.action == 'remove' %}
            A leaking barrel battery destroys traces; take it off the board before
            anything else.
            {% endif %}
        </li>
        {% endfor %}
    </ul>
</section>
{% endif %}
