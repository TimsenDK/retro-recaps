{# `batteries` is the machine's battery list. On a board page it is rendered
   only when that board declares `battery: true`, i.e. the cell really is on
   this PCB — the board page is the sheet that gets printed and carried to the
   bench, and a warning it cannot confirm applies is worse than none. #}
{% if batteries %}
<section class="battery" role="note">
    <h2>Battery — deal with this first</h2>
    <ul class="notes">
        {% for battery in batteries %}
        <li>
            <strong>{{ battery.kind | upper }} — {{ battery.action }}.</strong>
            {% if battery.note %}{{ battery.note }}{% endif %}
            {% if battery.action == 'remove' %}
            A leaking barrel battery destroys traces; take it off the board before
            anything else.
            {% endif %}
        </li>
        {% endfor %}
    </ul>
</section>
{% endif %}
