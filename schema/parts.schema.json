{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retro-recaps.invalid/schema/parts.schema.json",
  "title": "Parts catalogue",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "manufacturer", "mpn", "series", "type", "capacitance_uf", "voltage_v"],
    "properties": {
      "id": { "$ref": "#/$defs/slug" },
      "manufacturer": { "type": "string", "minLength": 1 },
      "mpn": { "type": "string", "minLength": 1 },
      "series": { "$ref": "#/$defs/slug" },
      "type": {
        "enum": [
          "electrolytic-radial",
          "electrolytic-snap-in",
          "electrolytic-axial",
          "electrolytic-smd",
          "bipolar",
          "tantalum",
          "film-x2",
          "film-y2"
        ]
      },
      "capacitance_uf": { "type": "number", "exclusiveMinimum": 0 },
      "voltage_v": { "type": "number", "exclusiveMinimum": 0 },
      "diameter_mm": { "type": "number", "exclusiveMinimum": 0 },
      "height_mm": { "type": "number", "exclusiveMinimum": 0 },
      "lead_spacing_mm": { "type": "number", "exclusiveMinimum": 0 },
      "note": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
  }
}
