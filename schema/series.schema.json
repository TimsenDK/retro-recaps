{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retro-recaps.invalid/schema/series.schema.json",
  "title": "Capacitor series",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "manufacturer", "name", "type"],
    "properties": {
      "id": { "$ref": "#/$defs/slug" },
      "manufacturer": { "type": "string", "minLength": 1 },
      "name": { "type": "string", "minLength": 1 },
      "type": {
        "enum": [
          "electrolytic-radial",
          "electrolytic-snap-in",
          "electrolytic-axial",
          "electrolytic-smd",
          "bipolar",
          "tantalum",
          "film-x2",
          "film-y2"
        ]
      },
      "temperature_c": { "type": "integer", "minimum": 85 },
      "voltage_min_v": {
        "type": "number",
        "exclusiveMinimum": 0,
        "$comment": "Lowest working voltage the series is made in. Recorded only where a datasheet states it; a series with no range recorded constrains nothing."
      },
      "voltage_max_v": {
        "type": "number",
        "exclusiveMinimum": 0,
        "$comment": "Highest working voltage the series is made in. A position rated above this points the reader at a series that cannot supply the part."
      },
      "low_esr": { "type": "boolean" },
      "note": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
  }
}
