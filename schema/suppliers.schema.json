{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retro-recaps.invalid/schema/suppliers.schema.json",
  "title": "Suppliers",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "search_url"],
    "properties": {
      "id": { "$ref": "#/$defs/slug" },
      "name": { "type": "string", "minLength": 1 },
      "region": { "type": "string", "minLength": 2 },
      "product_url": { "type": "string", "pattern": "^https://.*\\{sku\\}" },
      "search_url": { "type": "string", "pattern": "^https://.*\\{mpn\\}" }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
  }
}
